# Kopieren nach .env.local.
#
# Achtung: Alles mit NEXT_PUBLIC_ landet im Browser-Bundle und ist öffentlich.
# Hier darf nie ein Schlüssel stehen. Die drei Werte unten ohne Prefix bleiben
# auf dem Server — sie sind genau deshalb ohne Prefix.

NEXT_PUBLIC_API_URL=http://localhost:8080

# Die Anmeldung läuft in dieser App und schreibt in dieselbe Datenbank wie der
# Go-Dienst. Lokal der Container aus api/compose.yaml, in Produktion Neon.
DATABASE_URL=postgres://haushalt:haushalt@localhost:5432/haushalt

# Mindestens 32 Zeichen. Erzeugen mit:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Die eigene Basisadresse. In Produktion die Vercel-Domain.
BETTER_AUTH_URL=http://localhost:3000

# Mailversand — Bestätigung, Passwort zurücksetzen, später die Erinnerungen.
#
# BEIDE leer lassen ist ein gültiger Zustand: Dann schreibt die App die Mail
# in die Serverkonsole, statt zu scheitern. So lässt sich alles durchspielen,
# bevor eine Domain eingerichtet ist.
#
# Mit Schlüssel: Resend verschickt nur an beliebige Adressen, wenn die Domain
# dort verifiziert ist (DNS-Einträge). MAIL_VON muss zu dieser Domain gehören.
# Ohne verifizierte Domain laesst Resend nur onboarding@resend.dev als
# Absender zu — und nur an die Adresse, mit der das Resend-Konto angemeldet
# ist. Alles andere gibt 403. Eine fremde Domain (gmail, outlook) geht nie:
# verifizieren kann man nur, was einem gehoert.
RESEND_API_KEY=
MAIL_VON="Haushalt <onboarding@resend.dev>"

# Wer sich registrieren darf. Mehrere durch Komma getrennt,
# Gross-/Kleinschreibung egal.
#
# FEHLT DIESE VARIABLE, DARF NIEMAND. Sichere Vorgabe mit Absicht: Die andere
# Richtung hiesse, dass ein vergessener Eintrag die Tuer still aufmacht.
# Geprueft wird im before-Haken von Better Auth (lib/auth.ts), nicht im
# Formular — /api/auth/sign-up/email steht offen im Netz.
ZUGANGSCODES=HAUSHALT-ALPHA
