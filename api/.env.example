# Kopieren nach .env und ausfüllen. .env ist in .gitignore.

APP_ENV=development
PORT=8080

# Neon-Verbindungsstring. Leer lassen, solange es keine Datenbank gibt — der
# Dienst läuft dann trotzdem und meldet in /healthz "nicht konfiguriert".
DATABASE_URL=

# Kommagetrennt. Später kommen die Vercel-Domain und die Vorschau-Domains dazu.
ALLOWED_ORIGINS=http://localhost:3000

# Erst ab T9 nötig.
ANTHROPIC_API_KEY=
