# Kopieren nach .env und ausfüllen. .env ist in .gitignore.

APP_ENV=development
PORT=8080

# Lokale Entwicklungsdatenbank aus compose.yaml — `make db-up` startet sie.
# sslmode=disable ist hier richtig; Neon verlangt dagegen sslmode=require.
DATABASE_URL=postgres://haushalt:haushalt@localhost:5432/haushalt?sslmode=disable

# Leer lassen heißt: Der Dienst läuft ohne Datenbank und meldet in /healthz
# "nicht konfiguriert". Steht hier eine Adresse, die nicht erreichbar ist,
# startet er im Entwicklungsmodus trotzdem und antwortet mit 503.

# Kommagetrennt. Später kommen hier die Vercel-Domain und die Vorschau-Domains
# dazu.
ALLOWED_ORIGINS=http://localhost:3000

# Anmeldung: der Schlüsselsatz der Web-App. Leer heißt, der Dienst kennt keine
# Anmeldung und behandelt jede Anfrage als anonym.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=

# Erst ab T9 nötig.
ANTHROPIC_API_KEY=
